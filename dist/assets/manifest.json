      "world/mountains.webp",
      "world/seasons.webp"
    ],
    "registeredCharacter": "world/traveler.webp",
    "themes": [
      "winter",
      "spring",
      "summer",
      "autumn"
    ],
    "gallery": "#style-guide",
    "generationPrompts": "scripts/living-art-prompts.md"
  },
  "characters": {
    "components": "src/avatar-system.jsx",
    "profileModel": "src/avatar-model.mjs",
    "registration": "src/character-atlas.json",
    "generationPrompts": "scripts/character-art-prompts.md",
    "identities": [
      "brunette",
      "blonde"
    ],
    "companions": [
      "cat",
      "puppy"
    ],
    "outfits": [
      "casual",
      "ski",
