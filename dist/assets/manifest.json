      "characters/brunette-wardrobe.webp",
      "characters/companions.webp",
      "characters/mochi-grey.webp"
    ],
    "mochi": {
      "appearance": "Silver-grey fur, teal cat collar and brass tag",
      "generationPrompt": "scripts/mochi-grey-art.md"
    }
  },
  "tabSettings": {
    "atlas": "world/tab-settings.webp",
